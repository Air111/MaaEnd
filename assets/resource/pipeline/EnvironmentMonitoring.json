{
    "EnvironmentMonitoringCaptureUid": {
        "desc": "任务开始先补一次账号识别；已缓存时直接跳过，手工滑索路径按账号匹配",
        "recognition": "DirectHit",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "CaptureUid",
        "custom_action_param": {
            "use_cache": true,
            "stay_on_current_screen": true,
            "allow_unknown": true
        },
        "post_delay": 0,
        "next": [
            "EnvironmentMonitoringMain"
        ]
    },
    "EnvironmentMonitoringMain": {
        "desc": "环境监测主流程",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FailureCollectorReset",
        "custom_action_param": {
            "key": "EnvironmentMonitoring"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "EnvironmentMonitoringLoop",
            "[JumpBack]SceneEnterMenuRegionalDevelopmentWulingEnvironmentMonitoring"
        ]
    },
    "EnvironmentMonitoringLoop": {
        "desc": "环境监测循环",
        "recognition": "And",
        "all_of": [
            "EnvironmentMonitoringCheckOutskirtsMonitoringTerminalText"
        ],
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "[JumpBack]OutskirtsMonitoringTerminal",
            "[JumpBack]MarkerStoneMonitoringTerminal",
            "EnvironmentMonitoringFinish"
        ]
    },
    "EnvironmentMonitoringFinish": {
        "desc": "汇总环境监测路线执行结果",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "FailureCollectorFinish",
        "custom_action_param": {
            "key": "EnvironmentMonitoring"
        },
        "post_delay": 0,
        "rate_limit": 0,
        // 这个节点是收集错误的节点，如果之前有节点报错，这个节点一定报错
        // 所以完全没有必要重复上报
        "focus": {
            "Node.PipelineNode.Failed": {
                "trace": false
            }
        }
    },
    "EnvironmentMonitoringTerminalFinish": {
        "desc": "当前环境监测终端完成",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    }
}
