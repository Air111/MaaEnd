{
    "task": [
        {
            "name": "ZiplineImport",
            "label": "$task.ZiplineImport.label",
            "entry": "ZiplineImportMain",
            "description": "$task.ZiplineImport.description",
            "group": [
                "open_world"
            ],
            "controller": [
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "Win32-Front",
                "ADB",
                "PlayCover"
            ],
            "option": [
                "ZiplineImportAnotherAccount",
                "ZiplineImportValleyIV",
                "ZiplineImportWuling"
            ]
        }
    ],
    "option": {
        "ZiplineImportAnotherAccount": {
            "type": "switch",
            "controller": [
                "Win32-Front",
                "ADB",
                "PlayCover"
            ],
            "label": "$option.ZiplineImportAnotherAccount.label",
            "description": "$option.ZiplineImportAnotherAccount.description",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "ZiplineImportUid"
                    ]
                }
            ],
            "default_case": "No"
        },
        "ZiplineImportUid": {
            "type": "input",
            "controller": [
                "Win32-Front",
                "ADB",
                "PlayCover"
            ],
            "label": "$option.ZiplineImportUid.label",
            "description": "$option.ZiplineImportUid.description",
            "inputs": [
                {
                    "name": "Uid",
                    "label": "$option.ZiplineImportUid.Uid.label",
                    "default": "",
                    "pipeline_type": "string",
                    "verify": "^(\\d{8,12})?$"
                }
            ],
            "pipeline_override": {
                "ZiplineImportMain": {
                    "attach": {
                        "uid": "{Uid}"
                    }
                }
            }
        },
        "ZiplineImportValleyIV": {
            "type": "switch",
            "label": "$global.region.ValleyIV",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "option": [
                        "ZiplineImportValleyIVRegions"
                    ],
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ZiplineImportValleyIVRegions": {
            "type": "checkbox",
            "label": "$option.ZiplineImportRegions.label",
            "cases": [
                {
                    "name": "TheHub",
                    "label": "$global.region.TheHub",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01_lv001": true
                            }
                        }
                    }
                },
                {
                    "name": "ValleyPass",
                    "label": "$global.region.ValleyPass",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01_lv002": true
                            }
                        }
                    }
                },
                {
                    "name": "AburreyQuarry",
                    "label": "$global.region.AburreyQuarry",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01_lv003": true
                            }
                        }
                    }
                },
                {
                    "name": "OriginiumSciencePark",
                    "label": "$global.region.OriginiumSciencePark",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01_lv005": true
                            }
                        }
                    }
                },
                {
                    "name": "OriginLodespring",
                    "label": "$global.region.OriginLodespring",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01_lv006": true
                            }
                        }
                    }
                },
                {
                    "name": "PowerPlateau",
                    "label": "$global.region.PowerPlateau",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map01_lv007": true
                            }
                        }
                    }
                }
            ]
        },
        "ZiplineImportWuling": {
            "type": "switch",
            "label": "$global.region.Wuling",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02": true
                            }
                        }
                    }
                },
                {
                    "name": "No",
                    "option": [
                        "ZiplineImportWulingRegions"
                    ],
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        },
        "ZiplineImportWulingRegions": {
            "type": "checkbox",
            "label": "$option.ZiplineImportRegions.label",
            "cases": [
                {
                    "name": "JingyuValley",
                    "label": "$global.region.JingyuValley",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv001": true
                            }
                        }
                    }
                },
                {
                    "name": "WulingCity",
                    "label": "$global.region.WulingCity",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv002": true
                            }
                        }
                    }
                },
                {
                    "name": "QingboStockade",
                    "label": "$global.region.QingboStockade",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv003": true
                            }
                        }
                    }
                },
                {
                    "name": "MarkerStone",
                    "label": "$global.region.MarkerStone",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv004": true
                            }
                        }
                    }
                },
                {
                    "name": "TestArea",
                    "label": "$global.region.TestArea",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv005": true
                            }
                        }
                    }
                },
                {
                    "name": "SwordVaultDale",
                    "label": "$global.region.SwordVaultDale",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv006": true
                            }
                        }
                    }
                },
                {
                    "name": "YinglungPass",
                    "label": "$global.region.YinglungPass",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv007": true
                            }
                        }
                    }
                },
                {
                    "name": "NorthWulingExclusionZone",
                    "label": "$global.region.NorthWulingExclusionZone",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv008": true
                            }
                        }
                    }
                },
                {
                    "name": "SnowyForest",
                    "label": "$global.region.SnowyForest",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv009": true
                            }
                        }
                    }
                },
                {
                    "name": "SisPainting",
                    "label": "$global.region.SisPainting",
                    "pipeline_override": {
                        "ZiplineImportMain": {
                            "attach": {
                                "include_map02_lv010": true
                            }
                        }
                    }
                }
            ]
        }
    }
}
