{
    "task": [
        {
            "name": "EnvironmentMonitoring",
            "label": "$task.EnvironmentMonitoring.label",
            "entry": "EnvironmentMonitoringCaptureUid",
            "description": "$task.EnvironmentMonitoring.description",
            "group": [
                "regional_development"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "Linux-Gamescope",
                "Linux-ScreenCast",
                "Linux-Wlroots",
                "PlayCover",
                "Win32-Front"
            ],
            "option": [
                "EnvironmentMonitoringPreferZipline"
            ]
        }
    ],
    "option": {
        "EnvironmentMonitoringPreferZipline": {
            "type": "switch",
            "label": "$task.EnvironmentMonitoring.PreferZipline.label",
            "description": "$task.EnvironmentMonitoring.PreferZipline.description",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "SavedZiplineRoutePreference": {
                            "attach": {
                                "prefer_saved": false
                            }
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
}
